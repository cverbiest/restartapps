<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DevWorkspaceLauncher.WinUI</RootNamespace>
    <AssemblyName>DevWorkspaceLauncher.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged: runs from its folder like the WinForms app, so the two stay comparable. The
         Windows App SDK runtime is carried in that folder, so it runs where the runtime is not
         installed; .NET itself stays framework-dependent, as in the WinForms app. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevWorkspaceLauncher.Core\DevWorkspaceLauncher.Core.csproj" />
  </ItemGroup>

  <!-- An unpackaged publish leaves out the app's own resource index, which holds the compiled XAML;
       without it the published app fails at startup (0xC000027B in Microsoft.UI.Xaml.dll). -->
  <Target Name="CopyAppPriToPublishDir" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
