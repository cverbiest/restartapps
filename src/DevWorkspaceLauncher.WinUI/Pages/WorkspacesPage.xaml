<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevWorkspaceLauncher.WinUI.Pages.WorkspacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevWorkspaceLauncher.WinUI">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Workspaces" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OpenTicked_Click" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Open every workspace ticked Open.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open ticked" />
                    </StackPanel>
                </Button>
                <Button Click="CloseTicked_Click"
                        ToolTipService.ToolTip="Ask the windows ticked Close to close. Never forced, so unsaved work still prompts.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="Close ticked" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Re-read the workspace list and check which ones are open.">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <ToggleButton x:Name="ShowAll" Content="Show all recent" Click="ShowAll_Click" />
                <DropDownButton x:Name="SessionButton" Content="Session">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SessionMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <TextBlock x:Name="Count" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="2"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The header row and the item template use the same column widths, so the columns line up. -->
            <Grid Padding="12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pref" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="Close" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="2" Text="Open" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="3" Text="Workspace" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="4" Text="Location" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <ListView x:Name="List" Grid.Row="1" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WorkspaceItem">
                        <Grid ColumnSpacing="8" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Button Click="Preferred_Click" Padding="6" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="{x:Bind PreferredTooltip}" AutomationProperties.Name="{x:Bind PreferredTooltip}">
                                <FontIcon Glyph="{x:Bind PreferredGlyph}" FontSize="14" />
                            </Button>
                            <CheckBox Grid.Column="1" MinWidth="0" IsChecked="{x:Bind Close, Mode=OneWay}" IsEnabled="{x:Bind IsOpen}"
                                      Click="Close_Click" ToolTipService.ToolTip="Include this window in Close ticked." />
                            <CheckBox Grid.Column="2" MinWidth="0" IsChecked="{x:Bind Open, Mode=OneWay}"
                                      Click="Open_Click" ToolTipService.ToolTip="Include this workspace in Open ticked, and in a saved session." />
                            <TextBlock Grid.Column="3" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Location}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Uri}" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Status}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <Button Grid.Column="6" Content="{x:Bind ActionText}" Click="Action_Click" HorizontalAlignment="Stretch" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
