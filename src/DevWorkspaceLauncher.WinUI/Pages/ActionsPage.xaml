<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevWorkspaceLauncher.WinUI.Pages.ActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevWorkspaceLauncher.WinUI">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Actions" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="What the launcher can do: start and stop applications, and its built-in actions. Drop an executable or shortcut here to add it as an application. Select actions to run them, or add them to an activity."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Click="Start_Click" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Start the selected applications that are not running, and run the selected built-in actions.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Click="Stop_Click" ToolTipService.ToolTip="Stop the selected applications.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestartButton" Click="Restart_Click" ToolTipService.ToolTip="Stop the selected applications, then start them again.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Restart" />
                    </StackPanel>
                </Button>
                <Button Click="Add_Click" ToolTipService.ToolTip="Add an application.">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button Click="Edit_Click" ToolTipService.ToolTip="Edit the selected application.">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                </Button>
                <Button Click="Delete_Click" ToolTipService.ToolTip="Delete the selected applications.">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <DropDownButton ToolTipService.ToolTip="Add the selected actions to an activity (applications as Start, built-in actions as Run).">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock Text="Add to activity" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ActivityMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Check again which applications are running.">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Click="EditConfig_Click" ToolTipService.ToolTip="Open the configuration file in its editor.">
                    <FontIcon Glyph="&#xE943;" FontSize="14" />
                </Button>
            </StackPanel>
            <TextBox x:Name="Search" Grid.Column="1" Width="240" PlaceholderText="Search" TextChanged="Search_TextChanged" />
        </Grid>

        <Grid Grid.Row="2"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The header row and the item template use the same column widths, so the columns line up.
                 Clicking a header sorts by its column (ColumnSort). -->
            <Grid Padding="12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Button x:Name="FavHeader" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Fav" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="NameHeader" Grid.Column="1" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Action" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="KindHeader" Grid.Column="2" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Kind" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="DetailsHeader" Grid.Column="3" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Command line or description" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="StopHeader" Grid.Column="4" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Stops by" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="StatusHeader" Grid.Column="5" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Status" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
            </Grid>

            <ListView x:Name="List" Grid.Row="1" SelectionMode="Extended" IsDoubleTapEnabled="True" DoubleTapped="List_DoubleTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ActionItem">
                        <Grid ColumnSpacing="8" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <Button Click="Favorite_Click" Padding="6" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Favorite: on the start page and in the tray menu, where an application starts or comes to the front, and a built-in action runs. Click to change."
                                    AutomationProperties.Name="Favorite">
                                <FontIcon Glyph="{x:Bind FavoriteGlyph}" Foreground="{x:Bind FavoriteBrush}" FontSize="14" />
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Kind}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Details}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Details}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind StopMethod}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Status}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
