<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevWorkspaceLauncher.WinUI.Pages.SshHostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:DevWorkspaceLauncher"
    xmlns:local="using:DevWorkspaceLauncher.WinUI">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SSH hosts" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="Intro"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Connect_Click" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Connect to the selected hosts.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="14" />
                        <TextBlock Text="Connect" />
                    </StackPanel>
                </Button>
                <Button Click="Add_Click" ToolTipService.ToolTip="Add a host to ~/.ssh/config.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button>
                <Button Click="Edit_Click" ToolTipService.ToolTip="Edit the selected host.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Click="Delete_Click" ToolTipService.ToolTip="Remove the selected hosts from ~/.ssh/config.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <Button Click="OpenFile_Click"
                        ToolTipService.ToolTip="Open ~/.ssh/config in an editor, for settings this tab does not edit. The list follows when you come back.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open file" />
                    </StackPanel>
                </Button>
                <DropDownButton ToolTipService.ToolTip="Add the selected hosts to an activity.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock Text="Add to activity" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ActivityMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <TextBox x:Name="Search" Grid.Column="1" Width="240" PlaceholderText="Search" TextChanged="Search_TextChanged" />
        </Grid>

        <Grid Grid.Row="2"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The header row and the item template use the same column widths, so the columns line up.
                 Clicking a header sorts by its column (ColumnSort). -->
            <Grid Padding="12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="FavHeader" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Fav" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="AliasHeader" Grid.Column="1" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Host (alias)" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="HostNameHeader" Grid.Column="2" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Host name" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="UserHeader" Grid.Column="3" Style="{StaticResource SortHeader}">
                    <TextBlock Text="User" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="IdentityHeader" Grid.Column="4" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Identity file" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="AlsoHeader" Grid.Column="5" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Also" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
            </Grid>

            <ListView x:Name="List" Grid.Row="1" SelectionMode="Extended" IsDoubleTapEnabled="True" DoubleTapped="List_DoubleTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:SshHost">
                        <Grid ColumnSpacing="8" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Click="Favorite_Click" Padding="6" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Favorite: on the start page and in the tray menu. Click to change."
                                    AutomationProperties.Name="Favorite">
                                <FontIcon Glyph="{x:Bind local:LaunchItem.PinGlyph(Favorite)}" Foreground="{x:Bind local:LaunchItem.PinBrush(Favorite)}" FontSize="14" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{x:Bind Alias}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind HostName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind User}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind IdentityFile}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Also}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
