<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevWorkspaceLauncher.WinUI.Pages.LaunchItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevWorkspaceLauncher.WinUI">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="Intro"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Run_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Run the selected items.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewButton" Click="New_Click" ToolTipService.ToolTip="Create an empty activity; add items to it from any tab.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Click="Edit_Click" ToolTipService.ToolTip="Rename the selected activity and change what it does with each item.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Click="Delete_Click" ToolTipService.ToolTip="Delete the selected items.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <DropDownButton ToolTipService.ToolTip="Add the selected items to an activity.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock Text="Add to activity" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ActivityMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <TextBox x:Name="Search" Grid.Column="1" Width="240" PlaceholderText="Search" TextChanged="Search_TextChanged" />
        </Grid>

        <Grid Grid.Row="2"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The header row and the item template use the same column widths, so the columns line up.
                 Clicking a header sorts by its column (ColumnSort). -->
            <Grid Padding="12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Button x:Name="FavHeader" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Fav" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="NameHeader" Grid.Column="2" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button x:Name="TypeHeader" Grid.Column="3" Style="{StaticResource SortHeader}">
                    <TextBlock Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
            </Grid>

            <ListView x:Name="List" Grid.Row="1" SelectionMode="Extended" IsDoubleTapEnabled="True" DoubleTapped="List_DoubleTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LaunchItem">
                        <Grid ColumnSpacing="8" MinHeight="40" ToolTipService.ToolTip="{x:Bind Tooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Button Click="Favorite_Click" Padding="6" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="{x:Bind FavoriteTooltip}" AutomationProperties.Name="{x:Bind FavoriteTooltip}">
                                <FontIcon Glyph="{x:Bind FavoriteGlyph}" Foreground="{x:Bind FavoriteBrush}" FontSize="14" />
                            </Button>
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="16" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Kind}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
