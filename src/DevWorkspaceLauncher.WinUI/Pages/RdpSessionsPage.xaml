<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevWorkspaceLauncher.WinUI.Pages.RdpSessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:DevWorkspaceLauncher">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="RDP sessions" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Double-click a session to connect. Passwords come from the generic credential named in Credential (Windows Credential Manager); they are never stored here."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ConnectButton" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Connect to the selected sessions.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE703;" FontSize="14" />
                    <TextBlock Text="Connect" />
                </StackPanel>
            </Button>
            <Button Click="Add_Click" ToolTipService.ToolTip="Add a session.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add" />
                </StackPanel>
            </Button>
            <Button Click="Edit_Click" ToolTipService.ToolTip="Edit the selected session.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock Text="Edit" />
                </StackPanel>
            </Button>
            <Button Click="Delete_Click" ToolTipService.ToolTip="Delete the selected sessions.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Delete" />
                </StackPanel>
            </Button>
            <Button Click="Credentials_Click"
                    ToolTipService.ToolTip="Open Windows Credential Manager. Add a generic credential there and put its name in a session's Credential field.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                    <TextBlock Text="Credentials" />
                </StackPanel>
            </Button>
            <Button Click="Import_Click"
                    ToolTipService.ToolTip="Add sessions from a Remote Desktop Plus favorites listing written by tools\Export-RdpPlusFavorites.ps1. Existing sessions are never overwritten.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                    <TextBlock Text="Import RDP+" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The header row and the item template use the same column widths, so the columns line up. -->
            <Grid Padding="12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Session" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="Computer" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="3" Text="Credential" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <ListView x:Name="List" Grid.Row="1" SelectionMode="Extended" IsDoubleTapEnabled="True" DoubleTapped="List_DoubleTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:RdpSession">
                        <Grid ColumnSpacing="8" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Host}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Credential}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
