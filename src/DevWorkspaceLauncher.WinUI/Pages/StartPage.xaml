<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevWorkspaceLauncher.WinUI.Pages.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevWorkspaceLauncher.WinUI">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Start" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Your favorites, in the order of the tray menu. Click a tile to run it; drag tiles to reorder them, or right-click a tile to move or unpin it."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <ItemsControl x:Name="Networks" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:WrapPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:NetworkItem">
                        <Button Padding="10,4" CornerRadius="12" Opacity="{x:Bind Opacity}"
                                Click="Network_Click" ToolTipService.ToolTip="{x:Bind Tooltip}">
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind ConnectText}" Click="NetworkConnect_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE71B;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Copy IP address" Tag="address" Click="NetworkCopy_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy name" Tag="name" Click="NetworkCopy_Click" />
                                    <MenuFlyoutItem Text="Copy all details" Tag="details" Click="NetworkCopy_Click" />
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center" Foreground="{x:Bind IconBrush}" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Address}" VerticalAlignment="Center" FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Note}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoNetwork" Margin="0,8,0,0" Visibility="Collapsed" Text="No network interfaces"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <HyperlinkButton x:Name="ShowHidden" Padding="0" Margin="0,4,0,0" Visibility="Collapsed" Click="ShowHidden_Click" />
        </StackPanel>

        <TextBlock
            x:Name="Empty"
            Grid.Row="1"
            Visibility="Collapsed"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="No favorites yet. Pin items on the All items, Activities, Actions, RDP sessions or SSH hosts tab to show them here and in the tray menu." />

        <GridView x:Name="Tiles" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tiles_ItemClick"
                  CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="Tiles_DragItemsCompleted">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:LaunchItem">
                    <Grid Width="168" Height="104" Padding="12" RowSpacing="6"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="6"
                          ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Move first" Tag="first" Click="Move_Click" />
                                <MenuFlyoutItem Text="Move earlier" Tag="earlier" Click="Move_Click" />
                                <MenuFlyoutItem Text="Move later" Tag="later" Click="Move_Click" />
                                <MenuFlyoutItem Text="Move last" Tag="last" Click="Move_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Unpin" Click="Unpin_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE77A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" HorizontalAlignment="Left"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Row="2" Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
