<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevWorkspaceLauncher.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="16" Spacing="12">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock Text="Configuration file" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Name="ConfigPath" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        <TextBlock
            Text="Shared with the WinForms app. Activities, sessions and profiles are edited here; saving the file reloads both apps."
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Edit config file" Click="EditConfig_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Open folder" Click="OpenFolder_Click" />
        </StackPanel>

        <TextBlock Text="Start at logon" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <RadioButtons x:Name="Startup" SelectionChanged="Startup_SelectionChanged">
            <x:String>Don't start</x:String>
            <x:String>In the tray only</x:String>
            <x:String>With the window open</x:String>
        </RadioButtons>
        <TextBlock x:Name="StartupOther" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        <TextBlock
            Text="Starts this copy of the launcher when you log on to Windows. In the tray only, it waits in the notification area: click the tray icon to open the window. Also in the tray menu, as Start with Windows."
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="SSH hosts" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <ComboBox x:Name="SshClient" Header="Open SSH hosts in" MinWidth="320" SelectionChanged="SshClient_SelectionChanged" />
        <TextBlock
            Text="WezTerm opens a tab in its SSH:&lt;host&gt; domain, which WezTerm makes for every host in ~/.ssh/config (a new window when WezTerm is not running). Windows Terminal runs ssh &lt;host&gt; in a new tab."
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
        <TextBlock x:Name="Version" IsTextSelectionEnabled="True" />
    </StackPanel>
</Page>
