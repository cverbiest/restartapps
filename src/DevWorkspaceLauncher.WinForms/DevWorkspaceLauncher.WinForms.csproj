<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DevWorkspaceLauncher.WinForms</AssemblyName>
    <RootNamespace>DevWorkspaceLauncher</RootNamespace>

    <!-- Publish settings live here rather than on the command line, so a bare `dotnet publish`
         produces the format we actually want. ReadyToRun precompiles the IL in the publish folder -
         the app and the Krypton assemblies alike - which is what a cold start spends its time on.
         The runtime identifier that ReadyToRun needs is kept out of the output path, so the
         published app stays in bin\<config>\<tfm>\publish instead of moving under a win-x64 folder. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- The SDK derives PublishDir separately, and would still slip win-x64 into it. -->
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krypton.Toolkit" Version="105.26.4.110" />
    <PackageReference Include="Krypton.Navigator" Version="105.26.4.110" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevWorkspaceLauncher.Core\DevWorkspaceLauncher.Core.csproj" />
  </ItemGroup>
</Project>
